<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\SaveGaze.Desktop\assets\SaveGaze.ico</ApplicationIcon>
    <AssemblyName>SaveGaze-Setup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SaveGaze.Core\BrandConfig.cs" Link="BrandConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\payload.zip" Condition="Exists('..\..\dist\payload.zip')">
      <LogicalName>SaveGaze.Setup.payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
